# =========================================================================
# FoxQuiz: Local Environment Variables Configuration Template
# =========================================================================
# Copy this file to '.env' and fill in your own credentials:
# cp .env.example .env
# =========================================================================

# -------------------------------------------------------------------------
# 1. Google Cloud Configuration
# -------------------------------------------------------------------------
# Your Google Cloud Project ID where Vertex AI and Firestore are hosted.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# The Google Application Credentials JSON key file path (if running locally).
# Alternatively, run 'gcloud auth application-default login' on your machine.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# -------------------------------------------------------------------------
# 2. Telemetry & Monitoring Settings (Optional)
# -------------------------------------------------------------------------
# The GCS Bucket Name used to stream GenAI logs and usage telemetry.
# Leave blank or unconfigured if you want to bypass cloud logging.
LOGS_BUCKET_NAME=your-gcs-telemetry-bucket-name

# Control whether raw message content is logged to the telemetry storage.
# Options: "CAPTURE_CONTENT" or "NO_CONTENT"
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# -------------------------------------------------------------------------
# 3. Application & Security Settings
# -------------------------------------------------------------------------
# CORS allowed origins (comma-separated list of domains).
# Example: "http://localhost:3000,https://foxquiz.app"
ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Set to "TRUE" to run integration tests using a local mock Firestore instead of live DB.
INTEGRATION_TEST=FALSE
